# Sao chép thành .env (ở thư mục gốc repo) nếu cần ghi đè cấu hình mặc định.
# Mọi biến đều TUỲ CHỌN.

# --- Phát triển: ghi đè API key thay vì dùng keychain (mục 13.2, bước 6) ---
# Không commit file .env chứa key thật.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Backend ---
# Chỉ nên để 127.0.0.1 (NFR-06). Docker cần 0.0.0.0 bên trong container.
# LEZIONELIVE_HOST=127.0.0.1
# LEZIONELIVE_PORT=8765
# Thư mục dữ liệu (SQLite, slide, log, model cache...). Mặc định:
#   Windows: %LOCALAPPDATA%\LezioneLive   macOS: ~/Library/Application Support/LezioneLive
# LEZIONELIVE_DATA_DIR=D:\LezioneLiveData
# LEZIONELIVE_LOG_LEVEL=INFO
# Origin của Vite dev server được phép gọi API (JSON list)
# LEZIONELIVE_DEV_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Đường dẫn Chrome/Edge dùng để xuất PDF (tự dò nếu bỏ trống)
# LEZIONELIVE_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Không tự nạp model Whisper khi khởi động
# LEZIONELIVE_DISABLE_STT_AUTOLOAD=false

# --- Lớp học trực tiếp: server HTTPS/WSS cho điện thoại đồng hành ---
# Chỉ mở khi bạn bấm "Dùng điện thoại"; mọi kết nối cần token (QR dùng một lần / token thiết bị).
# LEZIONELIVE_COMPANION_HOST=0.0.0.0
# LEZIONELIVE_COMPANION_PORT=8766

# --- Hugging Face (nơi tải model Whisper) ---
# HF_HOME=D:\hf-cache
